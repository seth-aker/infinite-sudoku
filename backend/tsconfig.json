{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "#test/*": ["./test/*"]
    },
    "target": "es2022",
    "module": "es2022",
    "moduleResolution":"bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  }
}
